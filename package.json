{
  "name": "puerta-abierta",
  "version": "0.1.0",
  "private": true,
  "description": "Puerta Abierta — sitio estático sin backend. Solo build y comprobaciones.",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.26.0"
  },
  "scripts": {
    "dev": "node scripts/sync-coverage-script.mjs && pnpm --filter ./apps/puerta-abierta dev",
    "build:test": "pnpm run validate:config && node scripts/sync-coverage-script.mjs && pnpm --filter ./apps/puerta-abierta build:test",
    "build": "node scripts/build-commercial.mjs",
    "build:pages": "pnpm run build && node scripts/generate-pages-headers.mjs && pnpm run check:pages",
    "check:pages": "node scripts/check-pages-build.mjs",
    "check": "pnpm run validate:config && pnpm run check:astro && pnpm run check:ts && pnpm run check:lint && pnpm run check:format",
    "check:astro": "pnpm --filter ./apps/puerta-abierta check",
    "check:ts": "tsc --noEmit --allowImportingTsExtensions true -p tsconfig.check.json",
    "check:lint": "eslint .",
    "check:format": "prettier --check .",
    "check:static": "node scripts/check-static.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "pnpm run build:test && pnpm run test:e2e:playwright",
    "test:e2e:playwright": "playwright test",
    "validate:config": "node --experimental-strip-types --no-warnings scripts/validate-config.mjs technical",
    "validate:config:commercial": "node --experimental-strip-types --no-warnings scripts/validate-config.mjs commercial",
    "contrast": "node scripts/contrast.mjs",
    "contrast:strict": "node scripts/contrast.mjs --strict",
    "budget:report": "node scripts/budget-report.mjs",
    "lighthouse:report": "node scripts/lighthouse-report.mjs",
    "test:perf": "pnpm run budget:report && pnpm run lighthouse:report -- --use-dist",
    "verify": "node scripts/verify.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "release:restore": "node scripts/release-restore.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.1",
    "astro-eslint-parser": "1.2.2",
    "eslint": "9.34.0",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.43.0",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
