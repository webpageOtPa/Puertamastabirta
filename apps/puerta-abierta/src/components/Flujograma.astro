---
import { FLUJOGRAMA } from "../data/flujograma.js";
---

<section class="section flujograma" id="flujograma" aria-labelledby="flujograma-titulo">
  <div class="container">
    <header class="flujograma__header">
      <p class="eyebrow">Del primer contacto al portafolio</p>
      <h2 id="flujograma-titulo">{FLUJOGRAMA.titulo}</h2>
      <p class="flujograma__intro">{FLUJOGRAMA.contexto}</p>
    </header>

    <figure class="flujograma__figura">
      <picture>
        <source media="(max-width: 768px)" type="image/webp" srcset={FLUJOGRAMA.mobileSrc} />
        <source type="image/webp" srcset={FLUJOGRAMA.desktopSrc} />
        <img
          src={FLUJOGRAMA.src}
          alt={FLUJOGRAMA.alt}
          width={FLUJOGRAMA.width}
          height={FLUJOGRAMA.height}
          loading="lazy"
          decoding="async"
        />
      </picture>
      <figcaption class="flujograma__pie">
        <span>Esquema del proceso de captación y comercialización.</span>
        <a href={FLUJOGRAMA.src}>Ver flujograma a tamaño completo</a>
      </figcaption>
    </figure>

    <details class="flujograma__texto">
      <summary>Leer las 10 etapas del flujograma</summary>
      <div class="flujograma__transcripcion">
        <p class="flujograma__subtitulo">{FLUJOGRAMA.subtitulo}</p>
        <p>{FLUJOGRAMA.lema}</p>
        <ol class="flujograma__pasos" role="list">
          {
            FLUJOGRAMA.pasos.map((paso, index) => (
              <li class="flujograma__paso">
                <span class="flujograma__numero" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div>
                  <h3>{paso.titulo}</h3>
                  <ul>
                    {paso.acciones.map((accion) => (
                      <li>{accion}</li>
                    ))}
                  </ul>
                  {index === 8 && (
                    <div class="flujograma__decision">
                      <p>
                        <strong>{FLUJOGRAMA.decision}</strong>
                      </p>
                      <p>
                        <strong>Sí:</strong> continuar al paso 10.
                      </p>
                      <p>
                        <strong>No:</strong> {FLUJOGRAMA.ajuste}. Volver al paso 9: seguimiento y
                        retroalimentación.
                      </p>
                    </div>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
        <div class="flujograma__firma">
          <p>{FLUJOGRAMA.cierre}</p>
          <p>{FLUJOGRAMA.firma} · {FLUJOGRAMA.marca}</p>
          <p>{FLUJOGRAMA.pie}</p>
        </div>
      </div>
    </details>
  </div>
</section>

<style>
  .flujograma {
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  .flujograma__header {
    max-width: 65ch;
    margin-bottom: var(--space-7);
  }

  .flujograma__header h2 {
    margin-top: var(--space-2);
  }

  .flujograma__intro {
    margin-top: var(--space-4);
    color: var(--color-muted);
  }

  .flujograma__figura {
    margin: 0;
    padding: clamp(0.5rem, 2vw, 1.5rem);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .flujograma__figura picture,
  .flujograma__figura img {
    display: block;
    width: 100%;
    height: auto;
  }

  .flujograma__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding: var(--space-4) var(--space-2) var(--space-2);
    color: var(--color-muted);
    font-size: var(--fs-small);
  }

  .flujograma__pie a {
    color: var(--color-action);
    padding-block: var(--space-2);
  }

  .flujograma__texto {
    margin-top: var(--space-5);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .flujograma__texto summary {
    cursor: pointer;
    padding: var(--space-5);
    font-family: var(--font-display);
    font-weight: var(--weight-display-strong);
    color: var(--color-ink);
  }

  .flujograma__texto summary::marker {
    color: var(--color-action);
  }

  .flujograma__texto summary:focus-visible {
    outline: 3px solid var(--color-focus-ring);
    outline-offset: 3px;
    border-radius: var(--radius-card);
  }

  .flujograma__transcripcion {
    border-top: 1px solid var(--color-border);
    padding: var(--space-5);
  }

  .flujograma__subtitulo {
    color: var(--color-ink);
    font-weight: var(--weight-body-strong);
    margin-bottom: var(--space-2);
  }

  .flujograma__pasos {
    list-style: none;
    padding: 0;
    margin: var(--space-6) 0;
    display: grid;
    gap: var(--space-6);
  }

  .flujograma__paso {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-4);
  }

  .flujograma__numero {
    font-family: var(--font-display);
    font-weight: var(--weight-display-strong);
    color: var(--color-action);
    border-top: 2px solid currentColor;
    padding-top: var(--space-2);
  }

  .flujograma__paso h3 {
    padding-top: var(--space-2);
    font-size: var(--fs-body);
  }

  .flujograma__paso ul {
    padding-left: var(--space-5);
    margin-top: var(--space-2);
    max-width: var(--measure-text);
  }

  .flujograma__decision {
    margin-top: var(--space-4);
    padding: var(--space-4);
    background: var(--color-surface);
    border-left: 3px solid var(--color-action);
  }

  .flujograma__decision p + p {
    margin-top: var(--space-2);
  }

  .flujograma__firma {
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: var(--fs-small);
  }

  @media (max-width: 600px) {
    .flujograma__header {
      margin-bottom: var(--space-5);
    }

    .flujograma__texto summary,
    .flujograma__transcripcion {
      padding: var(--space-4);
    }

    .flujograma__paso {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: var(--space-3);
    }
  }
</style>
