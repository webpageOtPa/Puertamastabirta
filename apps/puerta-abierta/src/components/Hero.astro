---
// Hero.astro — Portada urbana (PA-04, refinada en PA-06).
// ---------------------------------------------------------------------
// DISENO.md: imagen urbana panorámica con velo oscuro, titular blanco
// legible, CTA sólido "Hablar sobre mi local" → #contacto y secundaria
// hacia metodología. SIN texto DENTRO de la fotografía.
//
// Aquí se usa un placeholder SVG (apps/puerta-abierta/public/hero-
// urban.svg) declarado como "diagrama, no fotografía" en su <title>.
// Cuando llegue el asset real, se sustituye el `src` y se mantienen
// las dimensiones reservadas (width/height 1600×720) para no afectar
// CLS. El copy del titular/subtítulo vive en index.astro (PA-06) y no
// promete métricas, rentabilidad, blindaje ni resultados.

export interface Props {
  eyebrow: string;
  titulo: string;
  subtitulo: string;
  ctaPrimario?: { label: string; href: string };
  ctaSecundario?: { label: string; href: string };
}

const {
  eyebrow,
  titulo,
  subtitulo,
  ctaPrimario = { label: "Hablar sobre mi local", href: "#contacto" },
  ctaSecundario = { label: "Ver método", href: "#metodo" },
} = Astro.props as Props;
---

<section class="hero" aria-labelledby="hero-titulo">
  <div class="hero__media" aria-hidden="true">
    <img
      src="/hero-urban.svg"
      alt=""
      width="1600"
      height="720"
      decoding="async"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__veil"></div>
  </div>

  <div class="container hero__content">
    <p class="eyebrow hero__eyebrow">{eyebrow}</p>
    <h1 id="hero-titulo" class="hero__titulo">{titulo}</h1>
    <p class="hero__subtitulo">{subtitulo}</p>
    <div class="cluster hero__ctas">
      <a class="btn btn--primary" href={ctaPrimario.href}>{ctaPrimario.label}</a>
      <a class="btn btn--secondary hero__cta-sec" href={ctaSecundario.href}>
        {ctaSecundario.label}
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    color: #ffffff;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__veil {
    position: absolute;
    inset: 0;
    background: var(--hero-veil);
  }

  .hero__content {
    padding-block: clamp(4rem, 9vw, 7rem);
    max-width: 720px;
  }

  .hero__eyebrow {
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: var(--space-4);
  }

  .hero__titulo {
    color: #ffffff;
    text-wrap: balance;
    max-width: 18ch;
    margin-bottom: var(--space-5);
  }

  .hero__subtitulo {
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    max-width: 50ch;
    margin-bottom: var(--space-6);
  }

  .hero__cta-sec {
    border-color: rgba(255, 255, 255, 0.7);
    color: #ffffff;
  }

  .hero__cta-sec:hover {
    background-color: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    border-color: #ffffff;
  }

  @media (max-width: 768px) {
    .hero__content {
      padding-block: clamp(3rem, 9vw, 5rem);
    }

    .hero__ctas {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__ctas .btn {
      width: 100%;
    }
  }
</style>
